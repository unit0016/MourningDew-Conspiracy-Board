{
	"nodes":[
		{"id":"4ec72ec03176dedd","type":"group","x":-360,"y":-120,"width":740,"height":2200,"color":"4","label":"'UNUSED' Text Dump"},
		{"id":"c83a97a3a7a37212","type":"group","x":460,"y":-120,"width":560,"height":1680,"color":"4","label":"Captain Hook"},
		{
			"id":"b1c63d9350c58a90",
			"type":"text",
			"text":"unused_0 = stringsetloc(\"Hello?\", \"UNUSED_slash_UNUSED_gml_2_0_b\")",
			"styleAttributes":{},
			"x":-320,
			"y":-80,
			"width":560,
			"height":60,
			"color":"4"
		},
		{
			"id":"42ed4f310450cd6f",
			"type":"text",
			"text":"`unused_1 = stringsetloc(\"Like, uh, hey, maybe things took a weird route right now...\", \"UNUSED_slash_UNUSED_gml_3_0_b\")`",
			"styleAttributes":{},
			"x":-320,
			"y":20,
			"width":560,
			"height":80,
			"color":"4"
		},
		{
			"id":"0aba6a818a475e54",
			"type":"text",
			"text":"`\"I... I'm scared...\"`",
			"styleAttributes":{},
			"x":-170,
			"y":140,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"31bee1ffedf0104a",
			"type":"text",
			"text":"`\"This may be a strange question, but...\"`",
			"styleAttributes":{},
			"x":-240,
			"y":240,
			"width":400,
			"height":60,
			"color":"4"
		},
		{
			"id":"524234e5f6dc554e",
			"type":"text",
			"text":"`\"Where's PLUEY!? I wanna see my lil' PLUEY!!!\"`",
			"styleAttributes":{},
			"x":-260,
			"y":440,
			"width":440,
			"height":60,
			"color":"4"
		},
		{
			"id":"1ff5118e502544c0",
			"type":"text",
			"text":"`\"... Gosh, who am I kidding?\"`",
			"styleAttributes":{},
			"x":-195,
			"y":340,
			"width":310,
			"height":60,
			"color":"4"
		},
		{
			"id":"e7e3721a56474107",
			"type":"text",
			"text":"`\"ANSWER, DARN YOU!!! ANSWER!!!\"`",
			"styleAttributes":{},
			"x":-170,
			"y":540,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"d105f2b89c18b0b5",
			"type":"text",
			"text":"`WRONG! WRONG! WRONG!!!`",
			"styleAttributes":{},
			"x":-170,
			"y":640,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"6faa8dcc104e6300",
			"type":"text",
			"text":"`\"Hey, Ralsei. Looks like Kris is trying to tell you something.\"`",
			"styleAttributes":{},
			"x":-260,
			"y":740,
			"width":440,
			"height":80,
			"color":"4"
		},
		{
			"id":"2623934d699aebfd",
			"type":"text",
			"text":"`\"But...\"`",
			"styleAttributes":{},
			"x":-170,
			"y":860,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"4c74da39fc907351",
			"type":"text",
			"text":"`\"Can you see me...?\"`",
			"styleAttributes":{},
			"x":-170,
			"y":960,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"b9b7617b02ca5a1a",
			"type":"text",
			"text":"`\"(Tired)\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1060,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"1a3f45164fca0480",
			"type":"text",
			"text":"\"M-maybe I should talk to her...)\"",
			"styleAttributes":{},
			"x":-170,
			"y":1160,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"ca157aef65635427",
			"type":"text",
			"text":"\"HEY!!! TALK TO ME FROM THE FRONT!!!\"",
			"styleAttributes":{},
			"x":-170,
			"y":1260,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"b906954efcef9c75",
			"type":"text",
			"text":"`\"I... I know.\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1360,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"96c9204e1bce1d26",
			"type":"text",
			"text":"`\"* (You're there.)\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1460,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"2670e5954c374450",
			"type":"text",
			"text":"`\"HelpOut\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1560,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"040c47ace69cb09d",
			"type":"text",
			"text":"\"KRIS! Hey, help me out here!!!\"",
			"styleAttributes":{},
			"x":-180,
			"y":1660,
			"width":280,
			"height":60,
			"color":"4"
		},
		{
			"id":"2093443599803b73",
			"type":"text",
			"text":"`\" ... wait a sec.\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1760,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"eeceb10185e8b0e4",
			"type":"text",
			"text":"`\"Ummm, if this is too difficult...\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1860,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"215721f6c0277fb9",
			"type":"text",
			"text":"`\"Umm, gladly! Just give me a second...\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1960,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"5435a6c1819d7d12",
			"type":"text",
			"text":"Lines past this point do not contain the GML formatting.",
			"styleAttributes":{},
			"x":110,
			"y":140,
			"width":260,
			"height":60,
			"color":"1"
		},
		{
			"id":"1a8324a494fd78ff",
			"type":"text",
			"text":"psuedo-conversation? kris' responses flagged in yellow",
			"styleAttributes":{},
			"x":480,
			"y":-110,
			"width":520,
			"height":60,
			"color":"1"
		},
		{
			"id":"928104a422cc5988",
			"type":"text",
			"text":"Like, hey everybody! What's up!! Is this thing on?? LOL!!!",
			"styleAttributes":{},
			"x":480,
			"y":-20,
			"width":460,
			"height":80,
			"color":"4"
		},
		{
			"id":"cdc0d5f7fbb28da5",
			"type":"text",
			"text":"Did you not HEAR ME...?",
			"styleAttributes":{},
			"x":580,
			"y":100,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"d28ee96501de6d8c",
			"type":"text",
			"text":"Hey, say something... Say something already!",
			"styleAttributes":{},
			"x":480,
			"y":200,
			"width":460,
			"height":60,
			"color":"4"
		},
		{
			"id":"621855290f5f1007",
			"type":"text",
			"text":"I can hear you",
			"styleAttributes":{},
			"x":630,
			"y":300,
			"width":160,
			"height":60,
			"color":"3"
		},
		{
			"id":"91a77095770dbde0",
			"type":"text",
			"text":"... Which is, why it's kind of awkward, s-she's not even here...",
			"styleAttributes":{},
			"x":550,
			"y":700,
			"width":320,
			"height":60,
			"color":"4"
		},
		{
			"id":"a5639c3ec01ac4df",
			"type":"text",
			"text":"I just wanted you to look at me...",
			"styleAttributes":{},
			"x":550,
			"y":800,
			"width":320,
			"height":60,
			"color":"4"
		},
		{
			"id":"4e2aba1c9735967a",
			"type":"text",
			"text":"THEN WHY DIDN'T YOU SAY SOMETHING EARLIER!?",
			"styleAttributes":{},
			"x":580,
			"y":400,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"6356213d1f1304ed",
			"type":"text",
			"text":"Captain hook i will send you a video",
			"styleAttributes":{},
			"x":550,
			"y":500,
			"width":320,
			"height":60,
			"color":"3"
		},
		{
			"id":"7bc196a4eab75bf1",
			"type":"text",
			"text":"It's like...",
			"styleAttributes":{},
			"x":645,
			"y":600,
			"width":130,
			"height":60,
			"color":"4"
		},
		{
			"id":"97f2a7dc136f8a30",
			"type":"text",
			"text":"Uhh, yeah. That's what you want. For us to leave you alone.",
			"styleAttributes":{},
			"x":550,
			"y":900,
			"width":320,
			"height":60,
			"color":"4"
		}
	],
