{
	"nodes":[
		{
			"id":"b1c63d9350c58a90",
			"type":"text",
			"text":"unused_0 = stringsetloc(\"Hello?\", \"UNUSED_slash_UNUSED_gml_2_0_b\")",
			"styleAttributes":{},
			"x":-320,
			"y":-80,
			"width":560,
			"height":60,
			"color":"4"
		},
		{
			"id":"42ed4f310450cd6f",
			"type":"text",
			"text":"`unused_1 = stringsetloc(\"Like, uh, hey, maybe things took a weird route right now...\", \"UNUSED_slash_UNUSED_gml_3_0_b\")`",
			"styleAttributes":{},
			"x":-320,
			"y":20,
			"width":560,
			"height":80,
			"color":"4"
		},
		{
			"id":"0aba6a818a475e54",
			"type":"text",
			"text":"`\"I... I'm scared...\"`",
			"styleAttributes":{},
			"x":-170,
			"y":140,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"31bee1ffedf0104a",
			"type":"text",
			"text":"`\"This may be a strange question, but...\"`",
			"styleAttributes":{},
			"x":-240,
			"y":240,
			"width":400,
			"height":60,
			"color":"4"
		},
		{
			"id":"524234e5f6dc554e",
			"type":"text",
			"text":"`\"Where's PLUEY!? I wanna see my lil' PLUEY!!!\"`",
			"styleAttributes":{},
			"x":-260,
			"y":440,
			"width":440,
			"height":60,
			"color":"4"
		},
		{
			"id":"1ff5118e502544c0",
			"type":"text",
			"text":"`\"... Gosh, who am I kidding?\"`",
			"styleAttributes":{},
			"x":-195,
			"y":340,
			"width":310,
			"height":60,
			"color":"4"
		},
		{
			"id":"e7e3721a56474107",
			"type":"text",
			"text":"`\"ANSWER, DARN YOU!!! ANSWER!!!\"`",
			"styleAttributes":{},
			"x":-170,
			"y":540,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"d105f2b89c18b0b5",
			"type":"text",
			"text":"`WRONG! WRONG! WRONG!!!`",
			"styleAttributes":{},
			"x":-170,
			"y":640,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"6faa8dcc104e6300",
			"type":"text",
			"text":"`\"Hey, Ralsei. Looks like Kris is trying to tell you something.\"`",
			"styleAttributes":{},
			"x":-260,
			"y":740,
			"width":440,
			"height":80,
			"color":"4"
		},
		{
			"id":"2623934d699aebfd",
			"type":"text",
			"text":"`\"But...\"`",
			"styleAttributes":{},
			"x":-170,
			"y":860,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"4c74da39fc907351",
			"type":"text",
			"text":"`\"Can you see me...?\"`",
			"styleAttributes":{},
			"x":-170,
			"y":960,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"b9b7617b02ca5a1a",
			"type":"text",
			"text":"`\"(Tired)\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1060,
			"width":260,
			"height":60,
			"color":"4"
		}
	],
