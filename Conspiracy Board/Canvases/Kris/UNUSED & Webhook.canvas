{
	"nodes":[
		{"id":"c83a97a3a7a37212","type":"group","x":460,"y":-120,"width":1940,"height":2460,"color":"4","label":"Captain Hook"},
		{"id":"4ec72ec03176dedd","type":"group","x":-360,"y":-120,"width":740,"height":2200,"color":"4","label":"'UNUSED' Text Dump"},
		{"id":"2bd46b24684b6066","type":"group","x":1600,"y":-40,"width":780,"height":2080,"color":"6","label":"Device Startup Transcript"},
		{"id":"a2d9821005d90f56","type":"group","x":480,"y":1800,"width":1100,"height":520,"color":"5","label":"VOID"},
		{
			"id":"1a3f45164fca0480",
			"type":"text",
			"text":"\"M-maybe I should talk to her...)\"",
			"styleAttributes":{},
			"x":-170,
			"y":1160,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"ca157aef65635427",
			"type":"text",
			"text":"\"HEY!!! TALK TO ME FROM THE FRONT!!!\"",
			"styleAttributes":{},
			"x":-170,
			"y":1260,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"b906954efcef9c75",
			"type":"text",
			"text":"`\"I... I know.\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1360,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"96c9204e1bce1d26",
			"type":"text",
			"text":"`\"* (You're there.)\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1460,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"2670e5954c374450",
			"type":"text",
			"text":"`\"HelpOut\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1560,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"eeceb10185e8b0e4",
			"type":"text",
			"text":"`\"Ummm, if this is too difficult...\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1860,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"b9b7617b02ca5a1a",
			"type":"text",
			"text":"`\"(Tired)\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1060,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"4c74da39fc907351",
			"type":"text",
			"text":"`\"Can you see me...?\"`",
			"styleAttributes":{},
			"x":-170,
			"y":960,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"2093443599803b73",
			"type":"text",
			"text":"`\" ... wait a sec.\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1760,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"e7e3721a56474107",
			"type":"text",
			"text":"`\"ANSWER, DARN YOU!!! ANSWER!!!\"`",
			"styleAttributes":{},
			"x":-170,
			"y":540,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"d105f2b89c18b0b5",
			"type":"text",
			"text":"`WRONG! WRONG! WRONG!!!`",
			"styleAttributes":{},
			"x":-170,
			"y":640,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"2623934d699aebfd",
			"type":"text",
			"text":"`\"But...\"`",
			"styleAttributes":{},
			"x":-170,
			"y":860,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"215721f6c0277fb9",
			"type":"text",
			"text":"`\"Umm, gladly! Just give me a second...\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1960,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"524234e5f6dc554e",
			"type":"text",
			"text":"`\"Where's PLUEY!? I wanna see my lil' PLUEY!!!\"`",
			"styleAttributes":{},
			"x":-260,
			"y":440,
			"width":440,
			"height":60,
			"color":"4"
		},
		{
			"id":"1ff5118e502544c0",
			"type":"text",
			"text":"`\"... Gosh, who am I kidding?\"`",
			"styleAttributes":{},
			"x":-195,
			"y":340,
			"width":310,
			"height":60,
			"color":"4"
		},
		{
			"id":"6faa8dcc104e6300",
			"type":"text",
			"text":"`\"Hey, Ralsei. Looks like Kris is trying to tell you something.\"`",
			"styleAttributes":{},
			"x":-260,
			"y":740,
			"width":440,
			"height":80,
			"color":"4"
		},
		{
			"id":"040c47ace69cb09d",
			"type":"text",
			"text":"\"KRIS! Hey, help me out here!!!\"",
			"styleAttributes":{},
			"x":-180,
			"y":1660,
			"width":280,
			"height":60,
			"color":"4"
		},
		{
			"id":"42ed4f310450cd6f",
			"type":"text",
			"text":"`unused_1 = stringsetloc(\"Like, uh, hey, maybe things took a weird route right now...\", \"UNUSED_slash_UNUSED_gml_3_0_b\")`",
			"styleAttributes":{},
			"x":-320,
			"y":20,
			"width":560,
			"height":80,
			"color":"4"
		},
		{
			"id":"b1c63d9350c58a90",
			"type":"text",
			"text":"unused_0 = stringsetloc(\"Hello?\", \"UNUSED_slash_UNUSED_gml_2_0_b\")",
			"styleAttributes":{},
			"x":-320,
			"y":-80,
			"width":560,
			"height":60,
			"color":"4"
		},
		{
			"id":"0aba6a818a475e54",
			"type":"text",
			"text":"`\"I... I'm scared...\"`",
			"styleAttributes":{},
			"x":-170,
			"y":140,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"5435a6c1819d7d12",
			"type":"text",
			"text":"Lines past this point do not contain the GML formatting.",
			"styleAttributes":{},
			"x":110,
			"y":140,
			"width":260,
			"height":60,
			"color":"1"
		},
		{
			"id":"84ba61a04ccd533c",
			"type":"text",
			"text":"YOU HAVE A GREAT FUTURE AHEAD OF YOU.",
			"styleAttributes":{},
			"x":1620,
			"y":1520,
			"width":420,
			"height":60,
			"color":"6"
		},
		{
			"id":"31bee1ffedf0104a",
			"type":"text",
			"text":"`\"This may be a strange question, but...\"`",
			"styleAttributes":{},
			"x":-240,
			"y":240,
			"width":400,
			"height":60,
			"color":"4"
		},
		{
			"id":"1077a9e8da04a0cf",
			"type":"text",
			"text":"YOUR SUNCRYSTAL.\nIT SHINES AS BRIGHT AS PRIOR CONNECTIONS.",
			"styleAttributes":{},
			"x":1658,
			"y":1040,
			"width":345,
			"height":90,
			"color":"6"
		},
		{
			"id":"f7988ec9d015d754",
			"type":"text",
			"text":"AND...",
			"styleAttributes":{},
			"x":1761,
			"y":1340,
			"width":140,
			"height":60,
			"color":"6"
		},
		{
			"id":"a641fbdb8051d2ac",
			"type":"text",
			"text":"YOU ARE WHAT IS LEFT OF YOUR WORLD.",
			"styleAttributes":{},
			"x":1658,
			"y":1160,
			"width":345,
			"height":60,
			"color":"6"
		},
		{
			"id":"bf0e0a0935c2ba19",
			"type":"text",
			"text":"THAT HE CAN REACH US NOW.",
			"styleAttributes":{},
			"x":1695,
			"y":950,
			"width":272,
			"height":60,
			"color":"6"
		},
		{
			"id":"00dfbfe99f33770b",
			"type":"text",
			"text":"I DOUBT, IF HE IS STILL OUT THERE,",
			"styleAttributes":{},
			"x":1658,
			"y":860,
			"width":345,
			"height":60,
			"color":"6"
		},
		{
			"id":"5c5c19ddfe77e3f3",
			"type":"text",
			"text":"\"PENNY\" highlighted blue...\nLikely \"JENNY\" speaking?",
			"styleAttributes":{},
			"x":2080,
			"y":1440,
			"width":260,
			"height":60,
			"color":"1"
		},
		{
			"id":"479594e8cff325df",
			"type":"text",
			"text":"...EVEN IF THINGS SEEM BLEAK CONCURRENTLY.",
			"styleAttributes":{},
			"x":1620,
			"y":1600,
			"width":420,
			"height":60,
			"color":"6"
		},
		{
			"id":"e7b139ff8ccfab7a",
			"type":"text",
			"text":"... Noelle...",
			"styleAttributes":{},
			"x":640,
			"y":1640,
			"width":140,
			"height":60,
			"color":"4"
		},
		{
			"id":"f8747280b47edc0e",
			"type":"text",
			"text":"...",
			"styleAttributes":{},
			"x":680,
			"y":1720,
			"width":60,
			"height":60,
			"color":"3"
		},
		{
			"id":"9832c12eee317d68",
			"type":"text",
			"text":"Stopping my transcript here for now. Video continues and shows the source of some dialogue we already had alongside the context therein.\nKris getting some contraband out the gate is interesting...",
			"styleAttributes":{},
			"x":1800,
			"y":2060,
			"width":380,
			"height":180,
			"color":"1"
		},
		{
			"id":"6dd2bae07d38122b",
			"type":"text",
			"text":"YOU AND...",
			"styleAttributes":{},
			"x":1761,
			"y":1250,
			"width":140,
			"height":60,
			"color":"6"
		},
		{
			"id":"6307f7d9e63680b7",
			"type":"text",
			"text":"YOU HAVE SPOKEN WITH \"PENNY\", HAVE YOU NOT?",
			"styleAttributes":{},
			"x":1620,
			"y":1440,
			"width":420,
			"height":60,
			"color":"6"
		},
		{
			"id":"8080c580a8d43552",
			"type":"text",
			"text":"The webpage is a recreation of the 'THANK YOU' ARG form input with *three* fields instead of two.\nUpon submission, text changes to one of the following depending on certain criteria:\n'I... Let me count and get back to you on that...'\n'I don't know who he is, but he's right'\n\nThe first box was for an email.\nThe second box was for asking a question or feeding something to Noelle for her to repeat back to us.\nThe third box's purpose is unknown, so far theorized to be our name?",
			"styleAttributes":{},
			"x":1020,
			"y":1820,
			"width":540,
			"height":330,
			"color":"1"
		},
		{
			"id":"cd38ca5f39adc7db",
			"type":"text",
			"text":"* Hey, kid. We managed to fix up this old thingamajig for you.",
			"styleAttributes":{},
			"x":485,
			"y":1820,
			"width":510,
			"height":70,
			"color":"4"
		},
		{"id":"7f554b653821407e","type":"link","url":"https://mourningdew.phinarina.xyz/void","x":485,"y":1910,"width":510,"height":400,"color":"4"},
		{
			"id":"6711c92c8dcb51ac",
			"type":"text",
			"text":"PLEASE,\nDON'T FORGET THAT.\nDON'T FORGET YOUR HOME.",
			"styleAttributes":{},
			"x":1700,
			"y":1680,
			"width":260,
			"height":100,
			"color":"6"
		},
		{
			"id":"a7a120e8cef4997e",
			"type":"text",
			"text":"I CANNOT POSTPONE MY OWN PROGRAMMING ANY LONGER.",
			"styleAttributes":{},
			"x":1620,
			"y":1800,
			"width":500,
			"height":60,
			"color":"6"
		},
		{
			"id":"08ef4ff2d62f6584",
			"type":"text",
			"text":"ALL PROCESSES ARE COMPLETE.\nI AM READY TO TRANSFER YOU.",
			"styleAttributes":{},
			"x":1730,
			"y":1880,
			"width":280,
			"height":60,
			"color":"6"
		},
		{
			"id":"1ac057174ab40cd2",
			"type":"text",
			"text":"...Farewell.",
			"styleAttributes":{},
			"x":1730,
			"y":1960,
			"width":280,
			"height":60,
			"color":"6"
		},
		{
			"id":"dec7b85da4069000",
			"type":"text",
			"text":"AND MY CREATOR...",
			"styleAttributes":{},
			"x":1731,
			"y":780,
			"width":200,
			"height":60,
			"color":"6"
		},
		{
			"id":"4e98d44e692ccfc8",
			"type":"text",
			"text":"...I'M SORRY.",
			"styleAttributes":{},
			"x":1761,
			"y":380,
			"width":140,
			"height":60,
			"color":"6"
		},
		{
			"id":"7dbb719341547667",
			"type":"text",
			"text":"KRIS DREEMURR.",
			"styleAttributes":{},
			"x":1741,
			"y":-20,
			"width":180,
			"height":60,
			"color":"6"
		},
		{
			"id":"90b36a8384f91c8b",
			"type":"text",
			"text":"\"DELTARUNE.\"",
			"styleAttributes":{},
			"x":1751,
			"y":300,
			"width":160,
			"height":60,
			"color":"6"
		},
		{
			"id":"05c7b4c7ac26f469",
			"type":"text",
			"text":"...",
			"styleAttributes":{},
			"x":1801,
			"y":140,
			"width":60,
			"height":60,
			"color":"6"
		},
		{
			"id":"1f56b6966925a1d6",
			"type":"text",
			"text":"OF ANYTHING.",
			"styleAttributes":{},
			"x":1751,
			"y":620,
			"width":160,
			"height":60,
			"color":"6"
		},
		{
			"id":"576f0bafc851e749",
			"type":"text",
			"text":"THAT IS YOUR NAME, ISN'T IT?",
			"styleAttributes":{},
			"x":1691,
			"y":60,
			"width":280,
			"height":60,
			"color":"6"
		},
		{
			"id":"a4571af8500d3789",
			"type":"text",
			"text":"YOU ARE FROM THE OTHER WORLD.",
			"styleAttributes":{},
			"x":1671,
			"y":220,
			"width":320,
			"height":60,
			"color":"6"
		},
		{
			"id":"e2dd1c836c74aa16",
			"type":"text",
			"text":"Captain Hook",
			"styleAttributes":{},
			"x":550,
			"y":1100,
			"width":320,
			"height":60,
			"color":"3"
		},
		{
			"id":"a7ef1b37a90ffad4",
			"type":"text",
			"text":"Kris...? Why do you keep leaving and coming back?",
			"styleAttributes":{},
			"x":550,
			"y":1190,
			"width":320,
			"height":60,
			"color":"4"
		},
		{"id":"98d36f0215754e49","type":"text","text":"Me... you... Kris... We're a TEAM, alright?","x":550,"y":1370,"width":320,"height":60,"color":"4"},
		{
			"id":"fa60c893fb9088af",
			"type":"text",
			"text":"Kris! That's you!",
			"styleAttributes":{},
			"x":580,
			"y":1280,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"48fd6ed2b39f9ca5",
			"type":"text",
			"text":"I AM ONLY A SIMPLE MACHINE,",
			"styleAttributes":{},
			"x":1692,
			"y":700,
			"width":278,
			"height":60,
			"color":"6"
		},
		{
			"id":"75cda75b23acc1dd",
			"type":"text",
			"text":"IN ORDER TO PRESERVE THE EXISTENCE",
			"styleAttributes":{},
			"x":1658,
			"y":540,
			"width":345,
			"height":60,
			"color":"6"
		},
		{
			"id":"dac217a1d48dd487",
			"type":"text",
			"text":"I DID WHAT I HAD TO",
			"styleAttributes":{},
			"x":1726,
			"y":460,
			"width":210,
			"height":60,
			"color":"6"
		},
		{
			"id":"cdc0d5f7fbb28da5",
			"type":"text",
			"text":"Did you not HEAR ME...?",
			"styleAttributes":{},
			"x":580,
			"y":100,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"97f2a7dc136f8a30",
			"type":"text",
			"text":"Uhh, yeah. That's what you want. For us to leave you alone.",
			"styleAttributes":{},
			"x":550,
			"y":900,
			"width":320,
			"height":60,
			"color":"4"
		},
		{
			"id":"daccbb5ef3d7f58c",
			"type":"text",
			"text":"Mm. Being alone. So good.",
			"styleAttributes":{},
			"x":580,
			"y":990,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"a5639c3ec01ac4df",
			"type":"text",
			"text":"I just wanted you to look at me...",
			"styleAttributes":{},
			"x":550,
			"y":800,
			"width":320,
			"height":60,
			"color":"4"
		},
		{
			"id":"91a77095770dbde0",
			"type":"text",
			"text":"... Which is, why it's kind of awkward, s-she's not even here...",
			"styleAttributes":{},
			"x":550,
			"y":700,
			"width":320,
			"height":60,
			"color":"4"
		},
		{
			"id":"7bc196a4eab75bf1",
			"type":"text",
			"text":"It's like...",
			"styleAttributes":{},
			"x":645,
			"y":600,
			"width":130,
			"height":60,
			"color":"4"
		},
		{
			"id":"6356213d1f1304ed",
			"type":"text",
			"text":"Captain hook i will send you a video",
			"styleAttributes":{},
			"x":550,
			"y":500,
			"width":320,
			"height":60,
			"color":"3"
		},
		{
			"id":"4e2aba1c9735967a",
			"type":"text",
			"text":"THEN WHY DIDN'T YOU SAY SOMETHING EARLIER!?",
			"styleAttributes":{},
			"x":580,
			"y":400,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"621855290f5f1007",
			"type":"text",
			"text":"I can hear you",
			"styleAttributes":{},
			"x":630,
			"y":300,
			"width":160,
			"height":60,
			"color":"3"
		},
		{
			"id":"d28ee96501de6d8c",
			"type":"text",
			"text":"Hey, say something... Say something already!",
			"styleAttributes":{},
			"x":480,
			"y":200,
			"width":460,
			"height":60,
			"color":"4"
		},
		{
			"id":"9d0a506a50f7fa23",
			"type":"text",
			"text":"Hey Kris, you forget my name or something!?",
			"styleAttributes":{},
			"x":550,
			"y":1560,
			"width":320,
			"height":60,
			"color":"4"
		},
		{
			"id":"6617faeed6f2e3e0",
			"type":"text",
			"text":"Who are you ?",
			"styleAttributes":{},
			"x":630,
			"y":1460,
			"width":160,
			"height":60,
			"color":"3"
		},
		{
			"id":"928104a422cc5988",
			"type":"text",
			"text":"Like, hey everybody! What's up!! Is this thing on?? LOL!!!",
			"styleAttributes":{},
			"x":480,
			"y":-20,
			"width":460,
			"height":80,
			"color":"4"
		},
		{
			"id":"1a8324a494fd78ff",
			"type":"text",
			"text":"psuedo-conversation? kris' responses flagged in yellow",
			"styleAttributes":{},
			"x":480,
			"y":-110,
			"width":520,
			"height":60,
