{
	"nodes":[
		{"id":"c83a97a3a7a37212","type":"group","x":460,"y":-120,"width":1940,"height":6400,"color":"4","label":"Captain Hook (Noelle)"},
		{"id":"2bd46b24684b6066","type":"group","x":1600,"y":-40,"width":780,"height":6300,"color":"6","label":"Device Startup Transcript"},
		{"id":"a2d9821005d90f56","type":"group","x":480,"y":1800,"width":1100,"height":4460,"color":"5","label":"VOID"},
		{"id":"4ec72ec03176dedd","type":"group","x":-360,"y":-120,"width":740,"height":2200,"color":"4","label":"'UNUSED' Text Dump"},
		{
			"id":"7dbb719341547667",
			"type":"text",
			"text":"KRIS DREEMURR.",
			"styleAttributes":{},
			"x":1741,
			"y":-20,
			"width":180,
			"height":60,
			"color":"6"
		},
		{
			"id":"576f0bafc851e749",
			"type":"text",
			"text":"THAT IS YOUR NAME, ISN'T IT?",
			"styleAttributes":{},
			"x":1691,
			"y":60,
			"width":280,
			"height":60,
			"color":"6"
		},
		{
			"id":"75cda75b23acc1dd",
			"type":"text",
			"text":"IN ORDER TO PRESERVE THE EXISTENCE",
			"styleAttributes":{},
			"x":1658,
			"y":540,
			"width":345,
			"height":60,
			"color":"6"
		},
		{
			"id":"48fd6ed2b39f9ca5",
			"type":"text",
			"text":"I AM ONLY A SIMPLE MACHINE,",
			"styleAttributes":{},
			"x":1692,
			"y":700,
			"width":278,
			"height":60,
			"color":"6"
		},
		{
			"id":"1f56b6966925a1d6",
			"type":"text",
			"text":"OF ANYTHING.",
			"styleAttributes":{},
			"x":1751,
			"y":620,
			"width":160,
			"height":60,
			"color":"6"
		},
		{
			"id":"4e98d44e692ccfc8",
			"type":"text",
			"text":"...I'M SORRY.",
			"styleAttributes":{},
			"x":1761,
			"y":380,
			"width":140,
			"height":60,
			"color":"6"
		},
		{
			"id":"1a8324a494fd78ff",
			"type":"text",
			"text":"noelle's only capable in responding with lines she already has, interestingly. kris' responses flagged in yellow",
			"styleAttributes":{},
			"x":480,
			"y":-110,
			"width":520,
			"height":60,
			"color":"1"
		},
		{
			"id":"dec7b85da4069000",
			"type":"text",
			"text":"AND MY CREATOR...",
			"styleAttributes":{},
			"x":1731,
			"y":780,
			"width":200,
			"height":60,
			"color":"6"
		},
		{
			"id":"4e2aba1c9735967a",
			"type":"text",
			"text":"THEN WHY DIDN'T YOU SAY SOMETHING EARLIER!?",
			"styleAttributes":{},
			"x":580,
			"y":400,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"a4571af8500d3789",
			"type":"text",
			"text":"YOU ARE FROM THE OTHER WORLD.",
			"styleAttributes":{},
			"x":1671,
			"y":220,
			"width":320,
			"height":60,
			"color":"6"
		},
		{
			"id":"90b36a8384f91c8b",
			"type":"text",
			"text":"\"DELTARUNE.\"",
			"styleAttributes":{},
			"x":1751,
			"y":300,
			"width":160,
			"height":60,
			"color":"6"
		},
		{
			"id":"d105f2b89c18b0b5",
			"type":"text",
			"text":"`WRONG! WRONG! WRONG!!!`",
			"styleAttributes":{},
			"x":-170,
			"y":640,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"e7e3721a56474107",
			"type":"text",
			"text":"`\"ANSWER, DARN YOU!!! ANSWER!!!\"`",
			"styleAttributes":{},
			"x":-170,
			"y":540,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"7bc196a4eab75bf1",
			"type":"text",
			"text":"It's like...",
			"styleAttributes":{},
			"x":645,
			"y":600,
			"width":130,
			"height":60,
			"color":"4"
		},
		{
			"id":"621855290f5f1007",
			"type":"text",
			"text":"I can hear you",
			"styleAttributes":{},
			"x":630,
			"y":300,
			"width":160,
			"height":60,
			"color":"3"
		},
		{
			"id":"0aba6a818a475e54",
			"type":"text",
			"text":"`\"I... I'm scared...\"`",
			"styleAttributes":{},
			"x":-170,
			"y":140,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"dac217a1d48dd487",
			"type":"text",
			"text":"I DID WHAT I HAD TO",
			"styleAttributes":{},
			"x":1726,
			"y":460,
			"width":210,
			"height":60,
			"color":"6"
		},
		{
			"id":"d28ee96501de6d8c",
			"type":"text",
			"text":"Hey, say something... Say something already!",
			"styleAttributes":{},
			"x":480,
			"y":200,
			"width":460,
			"height":60,
			"color":"4"
		},
		{
			"id":"05c7b4c7ac26f469",
			"type":"text",
			"text":"...",
			"styleAttributes":{},
			"x":1801,
			"y":140,
			"width":60,
			"height":60,
			"color":"6"
		},
		{
			"id":"cdc0d5f7fbb28da5",
			"type":"text",
			"text":"Did you not HEAR ME...?",
			"styleAttributes":{},
			"x":580,
			"y":100,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"31bee1ffedf0104a",
			"type":"text",
			"text":"`\"This may be a strange question, but...\"`",
			"styleAttributes":{},
			"x":-240,
			"y":240,
			"width":400,
			"height":60,
			"color":"4"
		},
		{
			"id":"5435a6c1819d7d12",
			"type":"text",
			"text":"Lines past this point do not contain the GML formatting.",
			"styleAttributes":{},
			"x":110,
			"y":140,
			"width":260,
			"height":60,
			"color":"1"
		},
		{
			"id":"928104a422cc5988",
			"type":"text",
			"text":"Like, hey everybody! What's up!! Is this thing on?? LOL!!!",
			"styleAttributes":{},
			"x":480,
			"y":-20,
			"width":460,
			"height":80,
			"color":"4"
		},
		{
			"id":"42ed4f310450cd6f",
			"type":"text",
			"text":"`unused_1 = stringsetloc(\"Like, uh, hey, maybe things took a weird route right now...\", \"UNUSED_slash_UNUSED_gml_3_0_b\")`",
			"styleAttributes":{},
			"x":-320,
			"y":20,
			"width":560,
			"height":80,
			"color":"4"
		},
		{
			"id":"6faa8dcc104e6300",
			"type":"text",
			"text":"`\"Hey, Ralsei. Looks like Kris is trying to tell you something.\"`",
			"styleAttributes":{},
			"x":-260,
			"y":740,
			"width":440,
			"height":80,
			"color":"4"
		},
		{
			"id":"6356213d1f1304ed",
			"type":"text",
			"text":"Captain hook i will send you a video",
			"styleAttributes":{},
			"x":550,
			"y":500,
			"width":320,
			"height":60,
			"color":"3"
		},
		{
			"id":"91a77095770dbde0",
			"type":"text",
			"text":"... Which is, why it's kind of awkward, s-she's not even here...",
			"styleAttributes":{},
			"x":550,
			"y":700,
			"width":320,
			"height":60,
			"color":"4"
		},
		{
			"id":"1ff5118e502544c0",
			"type":"text",
			"text":"`\"... Gosh, who am I kidding?\"`",
			"styleAttributes":{},
			"x":-195,
			"y":340,
			"width":310,
			"height":60,
			"color":"4"
		},
		{
			"id":"524234e5f6dc554e",
			"type":"text",
			"text":"`\"Where's PLUEY!? I wanna see my lil' PLUEY!!!\"`",
			"styleAttributes":{},
			"x":-260,
			"y":440,
			"width":440,
			"height":60,
			"color":"4"
		},
		{
			"id":"b1c63d9350c58a90",
			"type":"text",
			"text":"unused_0 = stringsetloc(\"Hello?\", \"UNUSED_slash_UNUSED_gml_2_0_b\")",
			"styleAttributes":{},
			"x":-320,
			"y":-80,
			"width":560,
			"height":60,
			"color":"4"
		},
		{
			"id":"2623934d699aebfd",
			"type":"text",
			"text":"`\"But...\"`",
			"styleAttributes":{},
			"x":-170,
			"y":860,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"00dfbfe99f33770b",
			"type":"text",
			"text":"I DOUBT, IF HE IS STILL OUT THERE,",
			"styleAttributes":{},
			"x":1658,
			"y":860,
			"width":345,
			"height":60,
			"color":"6"
		},
		{
			"id":"a5639c3ec01ac4df",
			"type":"text",
			"text":"I just wanted you to look at me...",
			"styleAttributes":{},
			"x":550,
			"y":800,
			"width":320,
			"height":60,
			"color":"4"
		},
		{
			"id":"08db51e82b61315a",
			"type":"text",
			"text":"Dreemurr checks the menu. Kris doesn't have any contacts in their CELL, and has no weapon equipped at all. After exiting out, they check the mural of a monster SOUL - them, in reality.",
			"styleAttributes":{},
			"x":1800,
			"y":3900,
			"width":560,
			"height":100,
			"color":"5"
		},
		{
			"id":"e3b2925870362bc8",
			"type":"text",
			"text":"- (It is receiving enrichment from tamping the soft soil.)",
			"styleAttributes":{},
			"x":511,
			"y":3620,
			"width":460,
			"height":60,
			"color":"4"
		},
		{
			"id":"db95cf22b033b213",
			"type":"text",
			"text":"**§** It's a dusty old rug.\n**§** On it is the DELTA RUNE.",
			"styleAttributes":{},
			"x":1870,
			"y":3613,
			"width":240,
			"height":60,
			"color":"6"
		},
		{
			"id":"19bb56c4db42d664",
			"type":"text",
			"text":"They check the wall next to the closet.",
			"styleAttributes":{},
			"x":1920,
			"y":4460,
			"width":320,
			"height":60,
			"color":"5"
		},
		{
			"id":"683f2ffbd9eaa362",
			"type":"text",
			"text":"**§** (It's one of your brother's old shirts.)",
			"styleAttributes":{},
			"x":1915,
			"y":4980,
			"width":330,
			"height":60,
			"color":"6"
		},
		{
			"id":"7d986ce5af747e7a",
			"type":"text",
			"text":"**§** (It only has one stripe, and it was always too small for him.)",
			"styleAttributes":{},
			"x":1915,
			"y":5060,
			"width":330,
			"height":60,
			"color":"6"
		},
		{
			"id":"ba2d2281c840ccd6",
			"type":"text",
			"text":"Oh, a camera!",
			"styleAttributes":{},
			"x":665,
			"y":3960,
			"width":153,
			"height":60,
			"color":"4"
		},
		{
			"id":"f182f29f6d83a26d",
			"type":"text",
			"text":"- See you soon, honey.",
			"styleAttributes":{},
			"x":689,
			"y":4160,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"e9d11e8c41e5c0c4",
			"type":"text",
			"text":"End recording...",
			"styleAttributes":{},
			"x":689,
			"y":4240,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"33f6effed271ea0a",
			"type":"text",
			"text":"Haunting line choice, Noelle.",
			"styleAttributes":{},
			"x":1003,
			"y":4160,
			"width":260,
			"height":60,
			"color":"1"
		},
		{
			"id":"097e16ed64d4d197",
			"type":"text",
			"text":"I appreciate that in spite of the existential horror they're still focused on the bit. If nothing else Kris is always dependable in that department...",
			"styleAttributes":{},
			"x":1620,
			"y":3670,
			"width":180,
			"height":250,
			"color":"1"
		},
		{
			"id":"1ac46a36399e5fb8",
			"type":"text",
			"text":"**§** (Looks unfamiliar.)",
			"styleAttributes":{},
			"x":1980,
			"y":4020,
			"width":200,
			"height":60,
			"color":"6"
		},
		{
			"id":"9200136ab0fc76e2",
			"type":"text",
			"text":"**§** Not to be confused with DELTA RUNE, the town you live in.",
			"styleAttributes":{},
			"x":1825,
			"y":3700,
			"width":330,
			"height":60,
			"color":"6"
		},
		{
			"id":"39205631d22f1b3c",
			"type":"text",
			"text":"**§** It's an air mattress.\n**§** You've yet to collect the earth, fire, or water mattresses.",
			"styleAttributes":{},
			"x":1838,
			"y":3780,
			"width":305,
			"height":100,
			"color":"6"
		},
		{
			"id":"f71264abaac65921",
			"type":"text",
			"text":"Dreemurr spins the office chair around for a few seconds.",
			"styleAttributes":{},
			"x":1850,
			"y":4100,
			"width":460,
			"height":60,
			"color":"5"
		},
		{
			"id":"b47953586334c94c",
			"type":"text",
			"text":"**§** (They aren't worth looking through right now.)\n**§** (You've got a long day ahead.)",
			"styleAttributes":{},
			"x":1880,
			"y":4260,
			"width":400,
			"height":60,
			"color":"6"
		},
		{
			"id":"ac6655f46db55c4e",
			"type":"text",
			"text":"**§** (You work station. There are scattered papers on it.)",
			"styleAttributes":{},
			"x":1915,
			"y":4180,
			"width":330,
			"height":60,
			"color":"6"
		},
		{
			"id":"04353c21951bc5c2",
			"type":"text",
			"text":"- Good morning, sleepyhead! Breakfast is waiting!",
			"styleAttributes":{},
			"x":531,
			"y":3720,
			"width":420,
			"height":60,
			"color":"4"
		},
		{
			"id":"66ba80426bc8f1f9",
			"type":"text",
			"text":"- Kris! I... I still see someone! They're down there!",
			"styleAttributes":{},
			"x":531,
			"y":3800,
			"width":420,
			"height":60,
			"color":"4"
		},
		{
			"id":"5a8db8036e945826",
			"type":"text",
			"text":"- (Your hand lingers in the bright light.)",
			"styleAttributes":{},
			"x":567,
			"y":3880,
			"width":349,
			"height":60,
			"color":"4"
		},
		{
			"id":"2409d1206653f8b7",
			"type":"text",
			"text":"Well, at least it's off the carpet this time. Though how they managed to do this raises questions...",
			"styleAttributes":{},
			"x":1620,
			"y":3518,
			"width":230,
			"height":125,
			"color":"1"
		},
		{
			"id":"2d55d035c07ccbe1",
			"type":"text",
			"text":"**§** (You open your wardrobe.)\n**§** (...It's all remarkably similar to what you've been wearing.)",
			"styleAttributes":{},
			"x":1890,
			"y":4340,
			"width":380,
			"height":100,
			"color":"6"
		},
		{
			"id":"7dc297c610944834",
			"type":"text",
			"text":"**§** (Just out of view,)",
			"styleAttributes":{},
			"x":1950,
			"y":4540,
			"width":260,
			"height":60,
			"color":"6"
		},
		{
			"id":"801b1ff41c8691ef",
			"type":"text",
			"text":"**§** Just perfectly out of view,",
			"styleAttributes":{},
			"x":1950,
			"y":4620,
			"width":260,
			"height":60,
			"color":"6"
		},
		{
			"id":"4b5f4f17e657db5d",
			"type":"text",
			"text":"**§** Was a closet",
			"styleAttributes":{},
			"x":1950,
			"y":4700,
			"width":260,
			"height":60,
			"color":"6"
		},
		{
			"id":"3f9f5a5707340bd7",
			"type":"text",
			"text":"**§** You don't remember being there.)",
			"styleAttributes":{},
			"x":1930,
			"y":4780,
			"width":300,
			"height":60,
			"color":"6"
		},
		{
			"id":"c03305b7ae75a537",
			"type":"text",
			"text":"**§** As if they were your own,\nyour hands moved to open the door...",
			"styleAttributes":{},
			"x":1930,
			"y":4860,
			"width":300,
			"height":100,
			"color":"6"
		},
		{
			"id":"282ab8490133adf9",
			"type":"text",
			"text":"We are live, we are on air, we are recording, YOU are background noise! Get out!",
			"styleAttributes":{},
			"x":504,
			"y":4070,
			"width":629,
			"height":60,
			"color":"4"
		},
		{"id":"c245459b2bdbb869","type":"file","file":"Conspiracy Board/Events/Media/Noelle/End Recording.mp4","x":619,"y":4328,"width":400,"height":225},
		{
			"id":"377a94ccbc720e9e",
			"type":"text",
			"text":"**§** (Put it on?)",
			"styleAttributes":{},
			"x":2010,
			"y":5140,
			"width":140,
			"height":60,
			"color":"6"
		},
		{
			"id":"d674f182689dc34d",
			"type":"text",
			"text":"Interestingly, the way the SOUL tweens between choices implies the chapter's mechanics are mostly at parity with Chapter 5.",
			"styleAttributes":{},
			"x":1620,
			"y":5175,
			"width":320,
			"height":150,
			"color":"1"
		},
		{
			"id":"695a1706be4fa636",
			"type":"text",
			"text":"Dreemurr selects 'Yes', changing into the shirt.",
			"styleAttributes":{},
			"x":1975,
			"y":5220,
			"width":210,
			"height":60,
			"color":"5"
		},
		{
			"id":"6f027e12dc3d091c",
			"type":"text",
			"text":"**§** (There's a pencil in your brother's shirt pocket, next to the yellow line...)",
			"styleAttributes":{},
			"x":1960,
			"y":5295,
			"width":320,
			"height":60,
			"color":"6"
		},
		{
			"id":"dfe43afdd11d1664",
			"type":"text",
			"text":"**§** (Take it?)",
			"styleAttributes":{},
			"x":2060,
			"y":5380,
			"width":120,
			"height":60,
			"color":"6"
		},
		{
			"id":"48b99aad2d1fcdb7",
			"type":"text",
			"text":"Dreemurr selects 'Yes.'",
			"styleAttributes":{},
			"x":1990,
			"y":5460,
			"width":260,
			"height":60,
			"color":"5"
		},
		{
			"id":"0678ed9fb8f24d4f",
			"type":"text",
			"text":"**§** (You got the Pencil.)",
			"styleAttributes":{},
			"x":1990,
			"y":5540,
			"width":260,
			"height":60,
			"color":"6"
		},
		{
			"id":"fc6aa8aae4723410",
			"type":"text",
			"text":"**§** \"Pencil\" - Weapon 1 AT\n**§** Asriel's stolen pencil.\n**§** Slightly charred at the bottom.",
			"styleAttributes":{},
			"x":1990,
			"y":5620,
			"width":260,
			"height":120,
			"color":"6"
		},
		{
			"id":"27196a67e99b10d9",
			"type":"text",
			"text":"**§** Stamped \"CONTRABAND\", but you can see a purple dragon design underneath.\n**§** ...Might've been the reason he took it.",
			"styleAttributes":{},
			"x":1930,
			"y":5760,
			"width":380,
			"height":100,
			"color":"6"
		},
		{
			"id":"ec2dd793bf5114be",
			"type":"text",
			"text":"Dreemurr equips the pencil as a weapon.",
			"styleAttributes":{},
			"x":1945,
			"y":5880,
			"width":350,
			"height":60,
			"color":"5"
		},
		{
			"id":"7eefb2c2ae81e378",
			"type":"text",
			"text":"**§** These clothes have no power over you anymore.",
			"styleAttributes":{},
			"x":1915,
			"y":5960,
			"width":410,
			"height":60,
			"color":"6"
		},
		{
			"id":"baf99be04f0aea5c",
			"type":"text",
			"text":"**§** Sickly purple and green.",
			"styleAttributes":{},
			"x":1990,
			"y":6040,
			"width":260,
			"height":60,
			"color":"6"
		},
		{
			"id":"fc90edbf40546718",
			"type":"text",
			"text":"**§** (...The green is on the inside.)",
			"styleAttributes":{},
			"x":1980,
			"y":6120,
			"width":280,
			"height":60,
			"color":"6"
		},
		{
			"id":"ad6976cbc7e4e658",
			"type":"text",
			"text":"Hear that!? We'll just go underground!!",
			"styleAttributes":{},
			"x":578,
			"y":3540,
			"width":325,
			"height":60,
			"color":"4"
		},
		{
			"id":"e4557cbb94659e7f",
			"type":"text",
			"text":"**§** It's stained.",
			"styleAttributes":{},
			"x":1920,
			"y":3520,
			"width":140,
			"height":60,
			"color":"6"
		},
		{
			"id":"423ef266cfa23249",
			"type":"text",
			"text":"**§** (You step back from the door\nand keep looking.)",
			"styleAttributes":{},
			"x":1850,
			"y":3440,
			"width":280,
			"height":60,
			"color":"6"
		},
		{
			"id":"d7402c6a5e463a8c",
			"type":"text",
			"text":"- WALL BREAK... EVERYONE FALL DOWN...",
			"styleAttributes":{},
			"x":555,
			"y":3460,
			"width":371,
			"height":60,
			"color":"4"
		},
		{
			"id":"164ffbd869a02230",
			"type":"text",
			"text":"**§** (Yet...)\n**§** (The truth is clear.)",
			"styleAttributes":{},
			"x":1890,
			"y":3360,
			"width":200,
			"height":60,
			"color":"6"
		},
		{
			"id":"21112b641494cb87",
			"type":"text",
			"text":"How did you get here?",
			"styleAttributes":{},
			"x":634,
			"y":3380,
			"width":213,
			"height":60,
			"color":"5"
		},
		{
			"id":"93de729da116bf6b",
			"type":"text",
			"text":"**§** (The same face...)\n**§** (The same mind...)",
			"styleAttributes":{},
			"x":1890,
			"y":3280,
			"width":200,
			"height":60,
			"color":"6"
		},
		{
			"id":"4768d0cfa4124435",
			"type":"text",
			"text":"- ... wait. Stop. It's all like... uhh... fuzzy.",
			"styleAttributes":{},
			"x":571,
			"y":3300,
			"width":340,
			"height":60,
			"color":"4"
		},
		{
			"id":"4be5754c6a29d076",
			"type":"text",
			"text":"- Damn, it's dark in here...",
			"styleAttributes":{},
			"x":614,
			"y":3220,
			"width":253,
			"height":60,
			"color":"4"
		},
		{
			"id":"8fe371e179d1aec1",
			"type":"text",
			"text":"**§** (You know this is wrong.)\n**§** (You both\nknow this is wrong.)",
			"styleAttributes":{},
			"x":1870,
			"y":3160,
			"width":240,
			"height":100,
			"color":"6"
		},
		{
			"id":"d3e24bb123e0b4b5",
			"type":"text",
			"text":"Where are you?",
			"styleAttributes":{},
			"x":655,
			"y":3140,
			"width":172,
			"height":60,
			"color":"5"
		},
		{
			"id":"6b52b99849a78427",
			"type":"text",
			"text":"**§** (There seemed to be a note on your door, but it was torn off forcefully...)\n**§** (...)",
			"styleAttributes":{},
			"x":2000,
			"y":3020,
			"width":360,
			"height":100,
			"color":"6"
		},
		{
			"id":"4b13f5ee20c28ab2",
			"type":"text",
			"text":"Interestingly, this means MOURNINGDEW's first chapter takes place one day later than DELTARUNE's would have. By the time the angel arrives in MOURNINGDEW, A CYBER'S WORLD would've already been partly underway...",
			"styleAttributes":{},
			"x":1620,
			"y":2940,
			"width":340,
			"height":180,
			"color":"1"
		},
		{
			"id":"22c0559e92f5e768",
			"type":"text",
			"text":"- anyway, that's the gist of it.",
			"styleAttributes":{},
			"x":608,
			"y":3060,
			"width":265,
			"height":60,
			"color":"4"
		},
		{
			"id":"10e10b775f962407",
			"type":"text",
			"text":"Follow-up: these are 'teaching' you, yeah? You can repeat what we're giving you here?",
			"styleAttributes":{},
			"x":505,
			"y":2980,
			"width":470,
			"height":60,
			"color":"5"
		},
		{
			"id":"d31c64d07354b9bd",
			"type":"text",
			"text":"- (You put out your hand...)",
			"styleAttributes":{},
			"x":689,
			"y":4580,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"7717dea220ae1e72",
			"type":"text",
			"text":"- oh... my hands are phasing through the hammer...",
			"styleAttributes":{},
			"x":599,
			"y":4660,
			"width":440,
			"height":60,
			"color":"4"
		},
		{
			"id":"f62bc03860fa4ff7",
			"type":"text",
			"text":"Have you found the freedom you were hoping for?",
			"styleAttributes":{},
			"x":613,
			"y":4740,
			"width":411,
			"height":60,
			"color":"5"
		},
		{
			"id":"704d425dbbe9b623",
			"type":"text",
			"text":"- (Damn, kinda awkward without Kris here...)",
			"styleAttributes":{},
			"x":629,
			"y":4820,
			"width":381,
			"height":60,
			"color":"4"
		},
		{
			"id":"43cd791a1748b203",
			"type":"text",
			"text":"- Ho ho ho!!! I'm lost and confused!!!",
			"styleAttributes":{},
			"x":657,
			"y":4900,
			"width":326,
			"height":60,
			"color":"4"
		},
		{
			"id":"dc918279fa905e56",
			"type":"text",
			"text":"- But...",
			"styleAttributes":{},
			"x":760,
			"y":4980,
			"width":120,
			"height":60,
			"color":"4"
		},
		{
			"id":"4bc26e4ab16e6be6",
			"type":"text",
			"text":"- Why I Already Have Everything I Could Ever Want",
			"styleAttributes":{},
			"x":609,
			"y":5060,
			"width":423,
			"height":60,
			"color":"4"
		},
		{
			"id":"dd4dfed3b4fdd511",
			"type":"text",
			"text":"(I'm happy!)",
			"styleAttributes":{},
			"x":751,
			"y":5145,
			"width":140,
			"height":60,
			"color":"4"
		},
		{
			"id":"67d5d78eba0dbb7f",
			"type":"text",
			"text":"- (You ran the water fountain.)",
			"styleAttributes":{},
			"x":680,
			"y":5240,
			"width":280,
			"height":60,
			"color":"4"
		},
		{
			"id":"caeb441bdcf987db",
			"type":"text",
			"text":"- (It's refreshingly cool.)",
			"styleAttributes":{},
			"x":690,
			"y":5320,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"fb02b4055659ce03",
			"type":"text",
			"text":"- ... but...",
			"styleAttributes":{},
			"x":690,
			"y":5400,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"f7715455d445395d",
			"type":"text",
			"text":"- I... I want to. I want to believe again.",
			"styleAttributes":{},
			"x":650,
			"y":5480,
			"width":340,
			"height":60,
			"color":"4"
		},
		{
			"id":"45728a9225c20594",
			"type":"text",
			"text":"- Your performance... it had something beyond the notes.",
			"styleAttributes":{},
			"x":580,
			"y":5560,
			"width":480,
			"height":60,
			"color":"4"
		},
		{
			"id":"21a5cc0ce16bf19b",
			"type":"text",
			"text":"... and look, carefully, past the edge of your periphery...",
			"styleAttributes":{},
			"x":600,
			"y":5640,
			"width":440,
			"height":60,
			"color":"4"
		},
		{
			"id":"5f7f7356e3d3bc54",
			"type":"text",
			"text":"**§** (It's a calendar. The present day is Friday.)\n**§** (You've been waiting a long, long time.)",
			"styleAttributes":{},
			"x":2000,
			"y":2940,
			"width":360,
			"height":60,
			"color":"6"
		},
		{
			"id":"63217b32599bdaf0",
			"type":"text",
			"text":"- ... yes?",
			"styleAttributes":{},
			"x":675,
			"y":2900,
			"width":130,
			"height":60,
			"color":"4"
		},
		{
			"id":"6c67eb019c8685d5",
			"type":"text",
			"text":"**§** Kris, are they late?\n**§** The Festival is starting, you know!",
			"styleAttributes":{},
			"x":1840,
			"y":2780,
			"width":300,
			"height":60,
			"color":"6"
		},
		{
			"id":"2188655120c197fb",
			"type":"text",
			"text":"Dialogue notably changed here.",
			"styleAttributes":{},
			"x":1620,
			"y":2775,
			"width":200,
			"height":70,
			"color":"1"
		},
		{
			"id":"57a08b63dd39baae",
			"type":"text",
			"text":"Explain\nthe clues",
			"styleAttributes":{},
			"x":685,
			"y":2740,
			"width":110,
			"height":60,
			"color":"4"
		},
		{
			"id":"6254bb21b463b6ee",
			"type":"text",
			"text":"D'vina stands up, takes a step forward, and then collapses immediately. It takes a few seconds for them to get back upright, before Dreemurr pushes them to examine the calendar.",
			"styleAttributes":{},
			"x":1620,
			"y":2860,
			"width":740,
			"height":60,
			"color":"5"
		},
		{
			"id":"32bb08b35ccac609",
			"type":"text",
			"text":"...I take it you haven't had the easiest time communicating?",
			"styleAttributes":{},
			"x":505,
			"y":2820,
			"width":470,
			"height":60,
			"color":"5"
		},
		{
			"id":"b962bb5674c2ef27",
			"type":"text",
			"text":"**§** Kris...?\n**§** Are you awake?",
			"styleAttributes":{},
			"x":1890,
			"y":2680,
			"width":200,
			"height":60,
			"color":"6"
		},
		{
			"id":"664b0d2861a9689f",
			"type":"text",
			"text":"- Hey, I can...",
			"styleAttributes":{},
			"x":610,
			"y":2660,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"22fcca0c85b87620",
			"type":"text",
			"text":"- I can talk to you when you get back, alright?",
			"styleAttributes":{},
			"x":540,
			"y":2580,
			"width":400,
			"height":60,
			"color":"4"
		},
		{
			"id":"3122d7478e02f948",
			"type":"text",
			"text":"- ... If you teach me or something..",
			"styleAttributes":{},
			"x":580,
			"y":2500,
			"width":320,
			"height":60,
			"color":"4"
		},
		{
			"id":"3498b0afa2e7594b",
			"type":"text",
			"text":"It then fades to the same SOUL transition used in 'the original game' / MANTLE, with Dreemurr controlling D'vina. Whatever original introduction was intended seems to be skipped, for the most part. D'vina is huddled against the wall holding the calendar, next to the door.",
			"styleAttributes":{},
			"x":1620,
			"y":2560,
			"width":740,
			"height":100,
			"color":"5"
		},
		{
			"id":"541ce387f58513c2",
			"type":"text",
			"text":"Room: PLACE_DOGCHECK2\nTick: 6.36ms\nStep: 1.16ms\nDraw: 33ms\nAudio: 0.56ms\nFree: 4935568 bytes\nVRAM Free: 0 bytes\nRoom Speed: 30\nAtlas: (9. 57. 1   )  \\[8/82 (57 pinned)\\]\n   256x256: 9/1217\nInstances: 9\nStruct",
			"styleAttributes":{},
			"x":1720,
			"y":2180,
			"width":300,
			"height":340,
			"color":"5"
		},
		{
			"id":"6d99d91f15a84640",
			"type":"text",
			"text":"- I Just Cannot Compute It",
			"styleAttributes":{},
			"x":610,
			"y":2420,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"7d4552414f15f931",
			"type":"text",
			"text":"- Speak. Normal.",
			"styleAttributes":{},
			"x":610,
			"y":2340,
			"width":260,
			"height":60,
			"color":"4"
		},
		{"id":"7f554b653821407e","type":"link","url":"https://mourningdew.phinarina.xyz/void","x":485,"y":1910,"width":510,"height":400,"color":"4"},
		{
			"id":"8080c580a8d43552",
			"type":"text",
			"text":"The webpage is a recreation of the 'THANK YOU' ARG form input with *three* fields instead of two.\nUpon submission, text changes to one of the following depending on certain criteria:\n'I... Let me count and get back to you on that...'\n'I don't know who he is, but he's right'\n\nThe first box was for an email.\nThe second box was for asking a question or feeding something to Noelle for her to repeat back to us.\nThe third box's purpose is unknown, so far theorized to be our name?\n\nOur inputs will be highlighted in blue.",
			"styleAttributes":{},
			"x":1020,
			"y":1820,
			"width":540,
			"height":360,
			"color":"1"
		},
		{
			"id":"fc69371708a5ce14",
			"type":"text",
			"text":"From here, 'Trouble Dingle' plays as what I can only describe as a spattering of graphics from UNDERTALE and DELTARUNE cut in somewhat randomly as a transition.\nBriefly, however; we're able to make out the following text:",
			"styleAttributes":{},
			"x":1620,
			"y":2040,
			"width":500,
			"height":120,
			"color":"5"
		},
		{
			"id":"215721f6c0277fb9",
			"type":"text",
			"text":"`\"Umm, gladly! Just give me a second...\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1960,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"1ac057174ab40cd2",
			"type":"text",
			"text":"...Farewell.",
			"styleAttributes":{},
			"x":1730,
			"y":1960,
			"width":280,
			"height":60,
			"color":"6"
		},
		{
			"id":"08ef4ff2d62f6584",
			"type":"text",
			"text":"ALL PROCESSES ARE COMPLETE.\nI AM READY TO TRANSFER YOU.",
			"styleAttributes":{},
			"x":1730,
			"y":1880,
			"width":280,
			"height":60,
			"color":"6"
		},
		{
			"id":"eeceb10185e8b0e4",
			"type":"text",
			"text":"`\"Ummm, if this is too difficult...\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1860,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"cd38ca5f39adc7db",
			"type":"text",
			"text":"* Hey, kid. We managed to fix up this old thingamajig for you.",
			"styleAttributes":{},
			"x":485,
			"y":1820,
			"width":510,
			"height":70,
			"color":"4"
		},
		{
			"id":"a7a120e8cef4997e",
			"type":"text",
			"text":"I CANNOT POSTPONE MY OWN PROGRAMMING ANY LONGER.",
			"styleAttributes":{},
			"x":1620,
			"y":1800,
			"width":500,
			"height":60,
			"color":"6"
		},
		{
			"id":"2093443599803b73",
			"type":"text",
			"text":"`\" ... wait a sec.\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1760,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"6711c92c8dcb51ac",
			"type":"text",
			"text":"PLEASE,\nDON'T FORGET THAT.\nDON'T FORGET YOUR HOME.",
			"styleAttributes":{},
			"x":1700,
			"y":1680,
			"width":260,
			"height":100,
			"color":"6"
		},
		{
			"id":"f8747280b47edc0e",
			"type":"text",
			"text":"...",
			"styleAttributes":{},
			"x":680,
			"y":1720,
			"width":60,
			"height":60,
			"color":"3"
		},
		{
			"id":"e7b139ff8ccfab7a",
			"type":"text",
			"text":"... Noelle...",
			"styleAttributes":{},
			"x":640,
			"y":1640,
			"width":140,
			"height":60,
			"color":"4"
		},
		{
			"id":"040c47ace69cb09d",
			"type":"text",
			"text":"\"KRIS! Hey, help me out here!!!\"",
			"styleAttributes":{},
			"x":-180,
			"y":1660,
			"width":280,
			"height":60,
			"color":"4"
		},
		{
			"id":"479594e8cff325df",
			"type":"text",
			"text":"...EVEN IF THINGS SEEM BLEAK CONCURRENTLY.",
			"styleAttributes":{},
			"x":1620,
			"y":1600,
			"width":420,
			"height":60,
			"color":"6"
		},
		{
			"id":"2670e5954c374450",
			"type":"text",
			"text":"`\"HelpOut\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1560,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"9d0a506a50f7fa23",
			"type":"text",
			"text":"Hey Kris, you forget my name or something!?",
			"styleAttributes":{},
			"x":550,
			"y":1560,
			"width":320,
			"height":60,
			"color":"4"
		},
		{
			"id":"84ba61a04ccd533c",
			"type":"text",
			"text":"YOU HAVE A GREAT FUTURE AHEAD OF YOU.",
			"styleAttributes":{},
			"x":1620,
			"y":1520,
			"width":420,
			"height":60,
			"color":"6"
		},
		{
			"id":"96c9204e1bce1d26",
			"type":"text",
			"text":"`\"* (You're there.)\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1460,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"6617faeed6f2e3e0",
			"type":"text",
			"text":"Who are you ?",
			"styleAttributes":{},
			"x":630,
			"y":1460,
			"width":160,
			"height":60,
			"color":"3"
		},
		{
			"id":"6307f7d9e63680b7",
			"type":"text",
			"text":"YOU HAVE SPOKEN WITH \"PENNY\", HAVE YOU NOT?",
			"styleAttributes":{},
			"x":1620,
			"y":1440,
			"width":420,
			"height":60,
			"color":"6"
		},
		{
			"id":"5c5c19ddfe77e3f3",
			"type":"text",
			"text":"\"PENNY\" highlighted blue...\nLikely \"JENNY\" speaking?",
			"styleAttributes":{},
			"x":2080,
			"y":1440,
			"width":260,
			"height":60,
			"color":"1"
		},
		{
			"id":"b906954efcef9c75",
			"type":"text",
			"text":"`\"I... I know.\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1360,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"4ebaf2cb55ffd4dc",
			"type":"text",
			"text":"'Thank you to everyone who helped me with the device'",
			"styleAttributes":{},
			"x":1090,
			"y":1340,
			"width":260,
			"height":60,
			"color":"3"
		},
		{
			"id":"f7988ec9d015d754",
			"type":"text",
			"text":"AND...",
			"styleAttributes":{},
			"x":1761,
			"y":1340,
			"width":140,
			"height":60,
			"color":"6"
		},
		{"id":"98d36f0215754e49","type":"text","text":"Me... you... Kris... We're a TEAM, alright?","x":550,"y":1370,"width":320,"height":60,"color":"4"},
		{
			"id":"ca157aef65635427",
			"type":"text",
			"text":"\"HEY!!! TALK TO ME FROM THE FRONT!!!\"",
			"styleAttributes":{},
			"x":-170,
			"y":1260,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"6dd2bae07d38122b",
			"type":"text",
			"text":"YOU AND...",
			"styleAttributes":{},
			"x":1761,
			"y":1250,
			"width":140,
			"height":60,
			"color":"6"
		},
		{
			"id":"fa60c893fb9088af",
			"type":"text",
			"text":"Kris! That's you!",
			"styleAttributes":{},
			"x":580,
			"y":1280,
			"width":260,
			"height":60,
			"color":"4"
		},
		{"id":"e77f29c811b91651","type":"link","url":"https://www.youtube.com/embed/iYpiRC20Rgs?si=JNWWvKBrlEzoCy2l","x":900,"y":950,"width":640,"height":360},
		{
			"id":"1a3f45164fca0480",
			"type":"text",
			"text":"\"M-maybe I should talk to her...)\"",
			"styleAttributes":{},
			"x":-170,
			"y":1160,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"a641fbdb8051d2ac",
			"type":"text",
			"text":"YOU ARE WHAT IS LEFT OF YOUR WORLD.",
			"styleAttributes":{},
			"x":1658,
			"y":1160,
			"width":345,
			"height":60,
			"color":"6"
		},
		{
			"id":"a7ef1b37a90ffad4",
			"type":"text",
			"text":"Kris...? Why do you keep leaving and coming back?",
			"styleAttributes":{},
			"x":550,
			"y":1190,
			"width":320,
			"height":60,
			"color":"4"
		},
		{
			"id":"b9b7617b02ca5a1a",
			"type":"text",
			"text":"`\"(Tired)\"`",
			"styleAttributes":{},
			"x":-170,
			"y":1060,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"1077a9e8da04a0cf",
			"type":"text",
			"text":"YOUR SUNCRYSTAL.\nIT SHINES AS BRIGHT AS PRIOR CONNECTIONS.",
			"styleAttributes":{},
			"x":1658,
			"y":1040,
			"width":345,
			"height":90,
			"color":"6"
		},
		{
			"id":"e2dd1c836c74aa16",
			"type":"text",
			"text":"Captain Hook",
			"styleAttributes":{},
			"x":550,
			"y":1100,
			"width":320,
			"height":60,
			"color":"3"
		},
		{
			"id":"daccbb5ef3d7f58c",
			"type":"text",
			"text":"Mm. Being alone. So good.",
			"styleAttributes":{},
			"x":580,
			"y":990,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"4c74da39fc907351",
			"type":"text",
			"text":"`\"Can you see me...?\"`",
			"styleAttributes":{},
			"x":-170,
			"y":960,
			"width":260,
			"height":60,
			"color":"4"
		},
		{
			"id":"bf0e0a0935c2ba19",
			"type":"text",
			"text":"THAT HE CAN REACH US NOW.",
			"styleAttributes":{},
			"x":1695,
			"y":950,
			"width":272,
			"height":60,
			"color":"6"
		},
		{
			"id":"97f2a7dc136f8a30",
			"type":"text",
			"text":"Uhh, yeah. That's what you want. For us to leave you alone.",
			"styleAttributes":{},
			"x":550,
			"y":900,
			"width":320,
			"height":60,
			"color":"4"
		},
		{
			"id":"1b66109455e32158",
			"type":"text",
			"text":"- Nubert's goin' further beyond.",
			"styleAttributes":{},
			"x":675,
			"y":5720,
			"width":290,
			"height":60,
			"color":"4"
		},
		{
			"id":"0d4f56ed785afd7d",
			"type":"text",
			"text":"- Miss, I think I still need your help.",
			"styleAttributes":{},
			"x":665,
			"y":5800,
			"width":310,
			"height":60,
			"color":"4"
		},
		{
			"id":"4d7c05df5f6c09da",
			"type":"text",
			"text":"- (I wish I had another worm to show me the way...)",
			"styleAttributes":{},
			"x":603,
			"y":5880,
			"width":435,
			"height":60,
			"color":"4"
		},
		{
			"id":"aaaea1972a4b47b0",
			"type":"text",
			"text":"- YOU'LL do our project.",
			"styleAttributes":{},
			"x":696,
			"y":5960,
			"width":250,
			"height":60,
			"color":"4"
		},
		{
			"id":"9e8d41580608b54b",
			"type":"text",
			"text":"- ... please... tell me..",
			"styleAttributes":{},
			"x":716,
			"y":6040,
			"width":209,
			"height":60,
			"color":"4"
		}
	],
